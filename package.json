{
	"author": "Paul Williams",
	"name": "@paulio/p69-files",
	"description": "Injects compile time tokens into CSS files",
	"type": "module",
	"license": "MIT",
	"version": "1.0.0-rc-5",
	"engines": {
		"node": ">=24"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/PaulioRandall/p69-files.git"
	},
	"keywords": [
		"css",
		"files"
	],
	"exports": {
		"./files": "./src/files.js",
		"./watch": "./src/watch.js"
	},
	"scripts": {
		"fmt": "prettier --log-level warn --write .",
		"test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --passWithNoTests --testPathPatterns ./src/",
		"audit": "npm run fmt && npm run test && cat ./ready-to-integrate.txt"
	},
	"devDependencies": {
		"jest": "30.4.2",
		"prettier": "3.9.0"
	},
	"dependencies": {
		"@paulio/p69": "4.0.0-rc-8",
		"chokidar": "5.0.0"
	}
}
